# Local development (copy to .env and export, or set in your shell).
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# DATABASE_URL=postgres://user:pass@localhost:5432/petals   # defaults to SQLite when unset

# Social sign-in (leave blank to disable). Comma-separated OAuth client IDs.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
