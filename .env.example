# Local development (copy to .env and export, or set in your shell).
DEBUG=true
SECRET_KEY=c80eac49dd4dbf84f6e7b6d276f906c81
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/petals   # defaults to SQLite when unset

# Neon: use the pooled URL at runtime; use the direct URL for deploy migrations.
MIGRATION_DATABASE_URL=

# Neon Buckets product-image storage (required outside DEBUG).
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE=
STORAGE_REGION=us-east-2

# Optional Brevo product-catalogue sync.
BREVO_API_KEY=
SITE_URL=http://localhost:5173

# Social sign-in (leave blank to disable). Comma-separated OAuth client IDs.
GOOGLE_CLIENT_IDS= 323789854363-eoltpro843sf3n5ee4hco0qd2vte4dod.apps.googleusercontent.com
APPLE_CLIENT_IDS=

# Email verification (local DEBUG=true uses the console backend unless EMAIL_HOST is set).
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
